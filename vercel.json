{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/gateway.js": {
      "maxDuration": 300,
      "includeFiles": "server/*.json"
    }
  },
  "rewrites": [
    {
      "source": "/ws",
      "destination": "/api/gateway"
    },
    {
      "source": "/api/receivers",
      "destination": "/api/gateway"
    },
    {
      "source": "/api/catalog",
      "destination": "/api/gateway"
    },
    {
      "source": "/api/health",
      "destination": "/api/gateway"
    },
    {
      "source": "/api/audio",
      "destination": "/api/gateway"
    },
    {
      "source": "/api/audio/tune",
      "destination": "/api/gateway"
    }
  ]
}
