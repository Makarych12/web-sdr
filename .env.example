# Production frontend and gateway share the same Vercel origin.
# No gateway URL or external hosting credentials are required.

# Primary international source: official QRZ XML lookup.
# Backend only; never use VITE_ prefixes or commit real values.
QRZ_USERNAME=
QRZ_PASSWORD=

# Free HamQTH account for international callbook fallback (backend only)
HAMQTH_USERNAME=
HAMQTH_PASSWORD=

# Optional rollback for the additional free USA source; 1 by default.
CALLOOK_ENABLED=1
# Restored legacy regional source (AU/CA/CZ/DE/US); 0 disables only HamDB.
HAMDB_ENABLED=1
