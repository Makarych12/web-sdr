{
  "name": "wave-websdr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --import tsx --test tests/*.test.js tests/*.test.ts",
    "verify:live": "node tests/live.js",
    "verify:browser": "node tests/browser.mjs",
    "verify:pwa": "node tests/pwa.mjs",
    "verify:sdr": "node tests/sdr-browser.mjs",
    "verify:ui": "node tests/ui-preview.mjs",
    "verify:production": "node tests/vercel-production.mjs",
    "verify:quality": "node tests/quality-production.mjs",
    "verify:hls": "node tests/hls-browser.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@vercel/functions": "^3.9.11",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "json5": "^2.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
